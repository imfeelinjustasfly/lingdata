    <TIER LINGUISTIC_TYPE_REF="utterance" PARTICIPANT="SPK1" TIER_ID="text@aim1984m">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a72"
                TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>аа ну какой каким ээ ты считаешь эти города для тебя?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER LINGUISTIC_TYPE_REF="utterance" PARTICIPANT="SPK1" TIER_ID="text@tik1938f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts11">
                <ANNOTATION_VALUE>я получается вырос в двух городах</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>это получается я родился в Балашове я прожил там десять лет ещё потом семь лет в Воронеже прожил</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>что ты там спрашивал?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts57">
                <ANNOTATION_VALUE>что я очень люблю эти города</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts58" TIME_SLOT_REF2="ts83">
                <ANNOTATION_VALUE>у меня получается о Балашове что в Балашове я детство своё всё провёл</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts82" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>о нём такие типа уютненькие приятные воспоминания</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts100" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>да уютные приятные воспоминания.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts123">
                <ANNOTATION_VALUE>что вот а в Воронеже что</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts124" TIME_SLOT_REF2="ts151">
                <ANNOTATION_VALUE>в Воронеже я провёл свои подростковые годы типа яркие такие запоминающиеся приятные</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts152" TIME_SLOT_REF2="ts163">
                <ANNOTATION_VALUE>вот ну вот вот так вот</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
